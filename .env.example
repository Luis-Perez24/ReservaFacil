# Los secretos se generan con: openssl rand -hex 32

NODE_ENV=development
PORT=3000

# Postgres — mismas variables para docker compose y para la API.
# Si ya tienes un Postgres nativo en el 5432, usa otro puerto acá (ej: 5433):
# el contenedor lo expone en el host y la API se conecta al mismo.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=reservafacil
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=reservafacil

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — dos secretos distintos y de 32 caracteres mínimo. Con el mismo secreto,
# un refresh token robado podría firmar access tokens.
JWT_ACCESS_SECRET=generar-con-openssl-rand-hex-32-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=generar-otro-distinto-con-openssl-rand-hex-32
JWT_REFRESH_TTL=7d

# Transbank Webpay Plus — ambiente de integración. Estos valores NO son
# secretos: los publica el propio SDK (transbank-sdk/IntegrationCommerceCodes
# e IntegrationApiKeys) para que cualquiera pueda probar contra su sandbox.
# En producción se reemplazan por los del convenio comercial real.
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
TRANSBANK_ENVIRONMENT=integration
TRANSBANK_RETURN_URL=http://localhost:3000/payments/webpay/return

# A dónde redirige el navegador tras el pago (ver WEB_BASE_URL en la API).
WEB_BASE_URL=http://localhost:4200

# SMTP del canal de email de recordatorios. En desarrollo: Mailpit
# (docker-compose, sin credenciales). En producción: un proveedor real,
# completando SMTP_USER/SMTP_PASSWORD.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=ReservaFácil <no-reply@reservafacil.cl>

# Asistente IA (adr/0004): function calling con Gemini. Se obtiene gratis en
# https://aistudio.google.com/apikey — Gemini nunca escribe en la base, solo
# elige qué función ejecutar.
GEMINI_API_KEY=tu-api-key-de-google-ai-studio
GEMINI_MODEL=gemini-2.0-flash
