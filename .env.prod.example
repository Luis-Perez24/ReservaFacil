# Variables del stack de producción (docker-compose.prod.yml), para el
# despliegue real en la VPS vía Coolify.
#
# Copiar a .env.prod y reemplazar TODOS los valores. En Coolify no se sube el
# archivo: cada variable se carga en la sección Environment Variables del
# recurso, que las guarda cifradas y genera el .env que este compose lee.
#
# Los secretos se generan con: openssl rand -hex 32

NODE_ENV=production
PORT=3000

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=reservafacil
POSTGRES_PASSWORD=reemplazar-con-openssl-rand-hex-24
POSTGRES_DB=reservafacil

# ── JWT — dos secretos distintos y de 32 caracteres mínimo ──────────────────
JWT_ACCESS_SECRET=reemplazar-con-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=reemplazar-con-otro-openssl-rand-hex-32-distinto
JWT_REFRESH_TTL=7d

# ── Transbank Webpay Plus ────────────────────────────────────────────────────
# Ambiente de integración. Estos valores NO son secretos: los publica el
# propio SDK para que cualquiera pueda probar contra su sandbox. Se mantienen
# así hasta tener un convenio comercial real con Transbank (ver limitaciones
# conocidas del proyecto).
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
TRANSBANK_ENVIRONMENT=integration
# Dominio real del stack, no localhost. Transbank redirige al navegador del
# comprador hasta aquí tras el pago.
TRANSBANK_RETURN_URL=https://reservafacil.lperez.dev/payments/webpay/return

# A dónde redirige el navegador tras el pago.
WEB_BASE_URL=https://reservafacil.lperez.dev

# ── Email de recordatorios ───────────────────────────────────────────────────
# Mailpit sigue siendo el "SMTP" también en producción (ver el comentario en
# docker-compose.prod.yml): no hay proveedor real contratado, y esto deja
# demostrable que el mecanismo de recordatorios funciona de punta a punta.
# SMTP_HOST y SMTP_PORT los fija el propio compose (apuntan al servicio
# `mailpit`); no hace falta declararlos aquí.
SMTP_FROM=ReservaFácil <no-reply@reservafacil.cl>

# Contraseña de la bandeja web de Mailpit (usuario fijo "demo", cambiable).
# Sin esto la bandeja queda abierta a cualquiera que encuentre el dominio, y
# ahi llegan nombre y email reales de quien reserve en la demo. Generar con:
#   openssl rand -base64 16
MAILPIT_UI_AUTH=demo:reemplazar-con-openssl-rand-base64-16

# ── Asistente IA ─────────────────────────────────────────────────────────────
# La misma clave que ya usas en desarrollo (ver .env local) — no se regenera
# para producción, es la misma cuenta de Google AI Studio.
GEMINI_API_KEY=la-misma-clave-que-en-tu-env-de-desarrollo
GEMINI_MODEL=gemini-2.0-flash
